# Variables que consume docker-compose.yml.
# Copiar a .env antes de ejecutar `docker compose up -d`.

# PostgreSQL
POSTGRES_USER=redsis
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=redsis
POSTGRES_PORT=5432

# Puertos publicados
API_PORT=3000
WEB_PORT=8080

# Secretos de firma. Obligatorios, distintos entre sí y de 32+ caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# Clave con la que se cifran las credenciales de los proveedores externos.
# 32 bytes en base64url o hexadecimal. Obligatoria: sin ella la API no arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Custodiarla es parte del despliegue: si se pierde, las credenciales guardadas
# dejan de poder descifrarse y hay que volver a introducirlas.
DATA_SOURCE_ENCRYPTION_KEY=

# Origen de los tickets: mock | redsis-one | baserow | servicenow | database
# Hoy solo `mock` está implementado; cualquier otro impide arrancar.
# Provisional: cuando las fuentes de datos se administren desde Configuración,
# el proveedor saldrá de la fuente y esta variable dejará de decidir nada.
TICKETS_PROVIDER=mock

# Origen del frontend, para CORS
CORS_ORIGIN=http://localhost:8080

# URL de la API que consume el navegador (se incrusta al compilar el frontend)
VITE_API_URL=http://localhost:3000/api

LOG_LEVEL=info
SWAGGER_ENABLED=true
