# Entorno de ejecución
NODE_ENV=development
PORT=3000

# PostgreSQL. En Docker el host es "postgres"; en local, "localhost".
DATABASE_URL=postgresql://redsis:redsis@localhost:5432/redsis?schema=public

# Secretos de firma. Deben ser distintos entre sí y tener 32+ caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development-only-secret-development-only
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=development-only-refresh-development-only
REFRESH_TOKEN_EXPIRES_IN=30d

# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Credenciales del administrador que crea la semilla
SEED_ADMIN_EMAIL=admin@redsis.com
SEED_ADMIN_PASSWORD=Redsis2026
SEED_ADMIN_NAME=Administrador

# Origen de los tickets: mock | redsis-one | baserow | servicenow | database
TICKETS_PROVIDER=mock

# Clave de cifrado de las credenciales de proveedores.
# 32 bytes en base64url. Obligatoria: sin ella la API no arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_SOURCE_ENCRYPTION_KEY=
