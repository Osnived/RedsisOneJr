// Esquema de la base de datos principal (PostgreSQL).
//
// Según STACK.md y PROJECT_CONTEXT.md, PostgreSQL almacena únicamente:
// usuarios, roles, permisos, logs, configuración, preferencias, sesiones,
// zonas y sucursales.
//
// Los datos operacionales (tickets, incidentes) viven en Baserow y se acceden
// mediante un Provider distinto. Nunca se almacenan usuarios ni permisos en Baserow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Persona autorizada para acceder a la plataforma.
/// No implica necesariamente que sea empleado de la empresa.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles           UserRole[]
  sessions        Session[]
  activityLogs    ActivityLog[]
  settings        Setting[]
  zones           UserZone[]
  roleAccessAudit RoleAccessAudit[]

  @@index([isActive])
  @@map("users")
}

/// Conjunto de accesos previamente definido. Los roles únicamente agrupan accesos.
///
/// El acceso tiene dos niveles: a qué módulos entra el rol (`modules`) y qué
/// acciones puede ejecutar dentro (`permissions`).
///
/// Preparado y sin implementar (ver Release 0.6): un rol podría declarar un rol
/// padre del que hereda accesos. Se resolvería al calcular el acceso efectivo,
/// no al guardarlo, para que cambiar el padre se refleje sin reescribir a los
/// hijos.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  /// Un rol desactivado conserva su configuración y deja de conceder acceso.
  isActive    Boolean  @default(true) @map("is_active")
  /// Concede todo lo que exista, ahora y en el futuro.
  ///
  /// El acceso de estos roles se calcula, no se almacena: cuando se añade un
  /// módulo o un permiso, ya lo tienen sin necesidad de migrar datos ni de que
  /// alguien se acuerde de marcarlo. Es lo que garantiza que la administración
  /// de la plataforma nunca se quede fuera por una configuración incompleta.
  ///
  /// No se deduce del nombre del rol: renombrar "administrador" no debe
  /// desarmar la garantía.
  hasFullAccess Boolean @default(false) @map("has_full_access")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]
  modules     RoleModule[]
  accessAudit RoleAccessAudit[]

  @@index([isActive])
  @@map("roles")
}

/// Acceso de un rol a un módulo de la plataforma.
///
/// El módulo se guarda por su clave y no como relación a una tabla: el catálogo
/// de módulos vive en el código (`APP_MODULE_DEFINITIONS`), porque un módulo
/// existe cuando alguien lo programa, no cuando alguien inserta una fila.
model RoleModule {
  roleId    String   @map("role_id") @db.Uuid
  module    String
  grantedAt DateTime @default(now()) @map("granted_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module])
  @@index([module])
  @@map("role_modules")
}

/// Cambio de acceso sobre un rol. Inmutable: no se edita ni se elimina.
///
/// Guarda el antes y el después completos en lugar de la diferencia:
/// reconstruir el estado a partir de diferencias exige la cadena intacta desde
/// el origen, y una sola pérdida la vuelve inútil.
model RoleAccessAudit {
  id                  String   @id @default(uuid()) @db.Uuid
  roleId              String   @map("role_id") @db.Uuid
  /// Nulo si el usuario que hizo el cambio se eliminó después.
  userId              String?  @map("user_id") @db.Uuid
  reason              String
  previousModules     String[] @map("previous_modules")
  newModules          String[] @map("new_modules")
  previousPermissions String[] @map("previous_permissions")
  newPermissions      String[] @map("new_permissions")
  occurredAt          DateTime @default(now()) @map("occurred_at")

  role Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roleId, occurredAt])
  @@map("role_access_audits")
}

/// Acción específica autorizada dentro del sistema. Unidad mínima de autorización.
/// El código sigue la convención `<modulo>.<accion>`, por ejemplo `tickets.create`.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Rol asignado a un usuario.
///
/// Es una relación de muchos a muchos, así que un usuario puede tener varios
/// roles desde el primer día. Lo que falta decidir es cómo se combinan dos roles
/// con accesos distintos; hoy se acumulan.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Permiso concedido a un rol.
///
/// Preparado y sin implementar (ver Release 0.6): los permisos temporales
/// añadirían vigencia (`validFrom`, `validUntil`) y el cálculo del acceso
/// efectivo descartaría lo caducado. Ese cálculo ya está en un solo sitio.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Sesión activa. Guarda el hash del refresh token para permitir revocación.
/// Nunca se almacena el token en texto plano.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Historial cronológico de acciones relevantes. Toda acción importante deja rastro.
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  module     String
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  occurredAt DateTime @default(now()) @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module, action])
  @@index([occurredAt])
  @@map("activity_logs")
}

/// Configuración global (userId nulo) o preferencia personal (userId asignado).
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("settings")
}

/// Área geográfica definida para organizar la operación de campo.
model Zone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]
  users    UserZone[]

  @@map("zones")
}

/// Lugar físico donde se realiza la atención del servicio.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  zoneId    String?  @map("zone_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId])
  @@map("branches")
}

model UserZone {
  userId     String   @map("user_id") @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([userId, zoneId])
  @@index([zoneId])
  @@map("user_zones")
}
