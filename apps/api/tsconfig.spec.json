{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // Las pruebas crean dobles parciales; exigir inicialización estricta
    // obligaría a rellenar campos que la prueba no usa.
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts"]
}
